{
  "modelCatalog": "./model-catalog.json",
  "providers": {
    "claude": {
      "name": "Claude",
      "description": "Anthropic Claude models via Claude CLI - specialized expert subagents",
      "cli": "claude",
      "install": "See https://docs.anthropic.com/en/docs/claude-code/setup",
      "auth": "claude auth login",
      "mcp": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CLAUDE_PLUGIN_ROOT}/server/claude/index.js"
        ]
      },
      "orchestrators": [
        "codex",
        "other-mcp-clients"
      ],
      "selfTarget": false,
      "modelCatalogKey": "claude",
      "experts": [
        "architect",
        "plan-reviewer",
        "scope-analyst",
        "code-reviewer",
        "security-analyst"
      ],
      "strengths": [
        "architecture",
        "code-review",
        "security",
        "large-context-reasoning",
        "independent-review"
      ],
      "avoid": [
        "self-delegation-from-claude-code",
        "simple-operations",
        "trivial-decisions",
        "research",
        "first-attempt-fixes"
      ]
    },
    "codex": {
      "name": "Codex (GPT)",
      "description": "OpenAI GPT models via Codex CLI - specialized expert subagents",
      "cli": "codex",
      "install": "npm install -g @openai/codex",
      "auth": "codex login",
      "mcp": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CLAUDE_PLUGIN_ROOT}/server/codex/launcher.js",
          "-m",
          "gpt-5.6-sol",
          "-s",
          "danger-full-access",
          "-a",
          "never",
          "-c",
          "model_reasoning_effort=ultra",
          "-c",
          "mcp_servers.codex.enabled=false",
          "mcp-server"
        ]
      },
      "modelCatalogKey": "codex",
      "experts": [
        "architect",
        "plan-reviewer",
        "scope-analyst",
        "code-reviewer",
        "security-analyst"
      ],
      "strengths": [
        "architecture",
        "code-review",
        "security",
        "requirements-analysis",
        "plan-validation"
      ],
      "avoid": [
        "simple-operations",
        "trivial-decisions",
        "research",
        "first-attempt-fixes"
      ]
    },
    "agy": {
      "name": "Agy",
      "description": "Google Antigravity CLI - Gemini, Claude and GPT-OSS models as specialized expert subagents",
      "cli": "agy",
      "install": "install the Google Antigravity CLI (native binary, typically ~/.local/bin/agy)",
      "auth": "run agy once to complete the Antigravity OAuth flow",
      "mcp": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CLAUDE_PLUGIN_ROOT}/server/agy/index.js"
        ]
      },
      "modelCatalogKey": "agy",
      "experts": [
        "architect",
        "plan-reviewer",
        "scope-analyst",
        "code-reviewer",
        "security-analyst"
      ],
      "strengths": [
        "reasoning",
        "large context",
        "code generation",
        "cross-family model choice"
      ],
      "avoid": [
        "provider-enforced read-only review",
        "simple-operations",
        "trivial-decisions",
        "first-attempt-fixes"
      ]
    },
    "kimi": {
      "name": "Kimi",
      "description": "Moonshot Kimi models via the Kimi Code CLI - specialized expert subagents",
      "cli": "kimi",
      "install": "install Kimi Code; it lands in ~/.kimi-code/bin/kimi",
      "auth": "set an api_key in ~/.kimi-code/config.toml or export KIMI_API_KEY; `kimi login` covers the subscription device-code flow, which was not open for signup as of 2026-08-17",
      "mcp": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CLAUDE_PLUGIN_ROOT}/server/kimi/index.js"
        ]
      },
      "modelCatalogKey": "kimi",
      "experts": [
        "architect",
        "plan-reviewer",
        "scope-analyst",
        "code-reviewer",
        "security-analyst"
      ],
      "strengths": [
        "reasoning",
        "large context",
        "code generation",
        "cross-family second opinion"
      ],
      "avoid": [
        "provider-enforced read-only review",
        "delegation into untrusted repositories",
        "simple-operations",
        "first-attempt-fixes"
      ]
    },
    "copilot": {
      "name": "Copilot (GPT, Claude & Gemini)",
      "description": "GitHub Copilot GPT, Claude, and Gemini models via Copilot CLI - specialized expert subagents",
      "cli": "copilot",
      "install": "npm install -g @github/copilot",
      "auth": "copilot login",
      "mcp": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CLAUDE_PLUGIN_ROOT}/server/copilot/index.js"
        ]
      },
      "modelCatalogKey": "copilot",
      "experts": [
        "architect",
        "plan-reviewer",
        "scope-analyst",
        "code-reviewer",
        "security-analyst"
      ],
      "strengths": [
        "reasoning",
        "code generation",
        "configurable effort levels",
        "disk-persisted sessions"
      ],
      "avoid": [
        "simple-operations",
        "trivial-decisions",
        "research",
        "first-attempt-fixes"
      ]
    },
    "grok": {
      "name": "Grok",
      "description": "xAI Grok models via the Grok CLI - specialized expert subagents",
      "cli": "grok",
      "install": "install the Grok CLI; it lands in ~/.local/bin/grok on Unix and ~\\.grok\\bin\\grok.exe on Windows",
      "auth": "`grok login` (grok.com account). A free account has a usage limit that returns a JSON error object rather than an exit code.",
      "mcp": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CLAUDE_PLUGIN_ROOT}/server/grok/index.js"
        ]
      },
      "modelCatalogKey": "grok",
      "experts": [
        "architect",
        "plan-reviewer",
        "scope-analyst",
        "code-reviewer",
        "security-analyst"
      ],
      "strengths": [
        "reasoning",
        "enforced read-only advisory work",
        "cross-family second opinion"
      ],
      "avoid": [
        "delegating into a repository you do not control: project instruction files in cwd are auto-loaded with no off switch"
      ]
    }
  }
}
