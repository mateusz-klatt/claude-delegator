{
  "name": "claude-delegator",
  "version": "3.4.0",
  "private": true,
  "description": "MCP bridges for delegating work between Claude, Codex, Agy, Kimi, Grok, Cursor, and Copilot CLIs.",
  "license": "Apache-2.0 AND MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    ".claude-plugin/*.json",
    "commands/*.md",
    "config/*.json",
    "config/*.toml",
    "prompts/*.md",
    "rules/*.md",
    "scripts/setup-mcp.js",
    "server/*/index.js",
    "server/shared/bridge.js",
    "server/shared/coordination.js",
    "server/shared/environment.js",
    "server/shared/provider-runtime.js",
    "server/shared/result.js",
    "test/mcp-probe.mjs",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "README.md",
    "claude-delegator.png"
  ],
  "scripts": {
    "setup:mcp": "node scripts/setup-mcp.js",
    "test": "node --test \"test/**/*.test.js\" \"server/**/*.test.js\"",
    "test:coverage": "c8 npm test"
  },
  "devDependencies": {
    "c8": "12.0.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
