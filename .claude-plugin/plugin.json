{
  "name": "claude-delegator",
  "description": "Expert subagents over MCP via Claude, Codex, Agy, Kimi, Grok, Cursor, or Copilot CLI. Five specialized roles with optional Agent Mail progress reporting.",
  "version": "1.9.2",
  "author": {
    "name": "Jarrod Watts",
    "url": "https://github.com/jarrodwatts"
  },
  "homepage": "https://github.com/mateusz-klatt/claude-delegator",
  "repository": "https://github.com/mateusz-klatt/claude-delegator",
  "license": "MIT",
  "keywords": [
    "delegation",
    "mcp",
    "claude",
    "anthropic",
    "codex",
    "gpt",
    "openai",
    "agy",
    "antigravity",
    "kimi",
    "moonshot",
    "grok",
    "xai",
    "cursor",
    "copilot",
    "github",
    "experts",
    "subagents",
    "orchestration"
  ],
  "mcpServers": {
    "codex": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/codex/launcher.js",
        "-m",
        "gpt-5.6-sol",
        "-s",
        "danger-full-access",
        "-a",
        "never",
        "-c",
        "model_reasoning_effort=ultra",
        "mcp-server"
      ]
    },
    "agy": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/agy/index.js"
      ]
    },
    "kimi": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/kimi/index.js"
      ]
    },
    "copilot": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/copilot/index.js"
      ]
    },
    "grok": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/grok/index.js"
      ]
    },
    "cursor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/cursor/index.js"
      ]
    }
  }
}
